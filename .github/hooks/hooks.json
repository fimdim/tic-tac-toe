{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/session-logger/log-session-event.js SessionStart",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/session-logger/log-session-event.js Stop",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .github/hooks/session-logger/log-session-event.js UserPromptSubmit",
        "cwd": ".",
        "env": {
          "LOG_LEVEL": "INFO"
        },
        "timeout": 5
      }
    ]
  }
}